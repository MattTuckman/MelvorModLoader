<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ExampleMod</AssemblyName>
    <RootNamespace>ExampleMod</RootNamespace>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <!-- Where the game is installed. Change this line if your Steam library is somewhere else,
         or pass it on the command line:  dotnet build -p:GameDir="D:\SteamLibrary\steamapps\common\Melvor Idle 2" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Melvor Idle 2</GameDir>

    <!-- Build straight into the game's mods folder: mods\ExampleMod\ExampleMod.dll -->
    <OutputPath>$(GameDir)\mods\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the loader, Godot and the game itself. Private=false: these are not copied next to
         your mod, the running game already has them. -->
    <Reference Include="MelvorModLoader">
      <HintPath>$(GameDir)\data_MelvorModLoader_windows_x86_64\MelvorModLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDir)\data_GamesByMalcs.Melvor2_windows_x86_64\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GamesByMalcs.Melvor2">
      <HintPath>$(GameDir)\data_GamesByMalcs.Melvor2_windows_x86_64\GamesByMalcs.Melvor2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
