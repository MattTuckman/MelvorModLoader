<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CombatAdvisor</AssemblyName>
    <RootNamespace>CombatAdvisor</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Melvor Idle 2 Combat Advisor</Product>
    <AssemblyTitle>Combat Advisor</AssemblyTitle>
    <Description>Before you fight: how fast you kill each monster, the XP and food per hour, and whether one of its hits can take you down, worked out from your own gear, stance, food and bonuses (requires Melvor Mod Loader).</Description>
    <Company>Melvor Mod Loader</Company>
    <Copyright>MIT License</Copyright>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GameData>..\..\..\data_GamesByMalcs.Melvor2_windows_x86_64</GameData>
    <LoaderDir>..\..\..\data_MelvorModLoader_windows_x86_64</LoaderDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- The fight model of the Adventurers mod (the game's own combat numbers), compiled into this mod. -->
    <Compile Include="..\Adventurers\Combat.cs" Link="Model\Combat.cs" />
    <Compile Include="..\Adventurers\Specials.cs" Link="Model\Specials.cs" />
    <Compile Include="..\Adventurers\Dungeons.cs" Link="Model\Dungeons.cs" />
    <Compile Include="..\Adventurers\Look.cs" Link="Model\Look.cs" />
    <Reference Include="MelvorModLoader"><HintPath>$(LoaderDir)\MelvorModLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameData)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GamesByMalcs.Melvor2"><HintPath>$(GameData)\GamesByMalcs.Melvor2.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
