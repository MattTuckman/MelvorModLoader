<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SaveBackup</AssemblyName>
    <RootNamespace>SaveBackup</RootNamespace>
    <Version>0.1.1</Version>
    <Product>Melvor Idle 2 Save Backup</Product>
    <AssemblyTitle>Save Backup</AssemblyTitle>
    <Description>Copies the save files to a dated backup folder every time the game starts (requires Melvor Mod Loader).</Description>
    <Company>Melvor Mod Loader</Company>
    <Copyright>MIT License</Copyright>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GameData>..\..\..\data_GamesByMalcs.Melvor2_windows_x86_64</GameData>
    <LoaderDir>..\..\..\data_MelvorModLoader_windows_x86_64</LoaderDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelvorModLoader"><HintPath>$(LoaderDir)\MelvorModLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameData)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GamesByMalcs.Melvor2"><HintPath>$(GameData)\GamesByMalcs.Melvor2.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
