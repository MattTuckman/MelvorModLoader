<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CheatMenu</AssemblyName>
    <RootNamespace>CheatMenu</RootNamespace>
    <Version>0.5.0</Version>
    <Product>Melvor Idle 2 Cheat Menu</Product>
    <AssemblyTitle>Cheat Menu</AssemblyTitle>
    <Description>Cheat and tuning menu for Melvor Idle 2 (requires Melvor Mod Loader). Opens with F8.</Description>
    <Company>Melvor Mod Loader</Company>
    <Copyright>MIT License</Copyright>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GameData>..\..\..\data_GamesByMalcs.Melvor2_windows_x86_64</GameData>
    <LoaderDir>..\..\..\data_MelvorModLoader_windows_x86_64</LoaderDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelvorModLoader"><HintPath>$(LoaderDir)\MelvorModLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameData)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GamesByMalcs.Melvor2"><HintPath>$(GameData)\GamesByMalcs.Melvor2.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
